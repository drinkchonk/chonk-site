# Chonk environment schema — copy to .env.local and fill in real values.
# .env.local is git-ignored; this file documents the keys without their secrets.

# Resend — transactional email for launch-vote notifications.
# Get the API key from https://resend.com/api-keys (one per environment).
RESEND_API_KEY=

# Verified Resend sender. Must be on a domain whose DNS is configured in Resend.
# Format: "Chonk <hello@chonkshakes.com.au>" or a bare email.
RESEND_FROM=

# Comma-separated list of recipients for each new launch-vote submission.
# Falls back to RESEND_REPLY_TO, then hello@chonkshakes.com.au, if empty.
LAUNCH_VOTE_TO=hello@chonkshakes.com.au
