# Resend (newsletter signup + welcome email)
# Dashboard: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Sender used on the welcome email. Must be on a verified Resend domain.
# While your domain is still pending verification, use the Resend test sender:
#   RESEND_FROM=onboarding@resend.dev
RESEND_FROM=chonk. <hello@chonkshakes.com.au>

# Optional: comma-separated inboxes for "Where should Chonk launch first?" votes.
# Falls back to RESEND_REPLY_TO, then hello@chonkshakes.com.au.
LAUNCH_VOTE_TO=hello@chonkshakes.com.au
